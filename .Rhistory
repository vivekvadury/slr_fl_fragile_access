### PART A source: "Creating W matrices in R"
###   Original author(s): Samantha Zuhlke and Scott Cook (Updated: July 2025)
### PART B source: "Network_Statistics.R" (WWI rivalry network)
###   Original author(s): Jude Hays
###
### This version combines both scripts, reorders content to match the Day 2
### Afternoon slide deck, and makes two substantive updates (both noted inline
### with "# UPDATED 2026" comments):
###   1. Removed the sfExtras GitHub dependency (unmaintained since 2019) in
###      favor of poly2nb(queen = FALSE), which produces the same rook
###      contiguity result using only spdep, already loaded for this lab.
###   2. Added a three-panel map of y and Wy (queen vs. kNN lags) to make the
###      "spatial lag as smoothed neighborhood average" idea visible before
###      the regression comparison that follows it.
##########################################
# data needed:
## cb_2017_us_state_500k.zip / .shp
## oxford_data.dta
## oxford_w.dta
## state_latlon.csv
## nodes.csv
## rivalry_edges.csv
##########################################
# set working directory
getwd()
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# packages
install.packages(c("sf","sp","spatialreg","ggplot2","dplyr","foreign","haven",
"spdep","units","igraph"))
library(sf)
library(sp)
library(spatialreg)
library(ggplot2)
library(dplyr)
library(foreign)
library(haven)
library(spdep)
library(units)
library(igraph)
# end preamble
##########################################################################
## PART A: SPATIAL TIES IN R
##########################################################################
# In practice, R emphasizes edge lists (pairs) over wide-shaped matrices.
# A neighbor list (nb)    = "summary" list of who is neighbors with whom
# A weighted list (listw) = an nb list plus a normalization strategy applied
# A weighted list is usually required by spatial functions.
# You can convert freely between nb, listw, and the full W matrix — different
# commands in R require different formats.
##########################################################
## Building W from a shapefile
##########################################################
# import spatial data, clean, and check projection
unzip("cb_2017_us_state_500k.zip")
states <- st_read("cb_2017_us_state_500k.shp")
class(states)
states_contig <- subset(states, NAME != "Commonwealth of the Northern Mariana Islands" &
NAME != "United States Virgin Islands"  & NAME != "American Samoa" &
NAME != "Puerto Rico" & NAME != "Guam")
# check projection
st_crs(states_contig)
# transform/convert coordinates to Albers Equal Area Conic
states_contig_albers <- st_transform(states_contig, 5070)
# check projection
st_crs(states_contig_albers)
# merge with data of interest (Oxford data we've been using)
oxford <- read.dta("oxford_data.dta") # read in a .dta (Stata) file
# add additional attributes to spatial data
spatial_attributes <- merge(states_contig_albers, oxford, by.x=c("STUSPS"), by.y=c("statenm"))
spatial_attributes
plot(spatial_attributes["ben95"])  # Aid to Families with Dependent Children (AFDC)
# queen contiguity
states.nb <- poly2nb(spatial_attributes, queen = T)
head(states.nb)
plot(st_geometry(spatial_attributes), border = "lightgray")
plot.nb(states.nb, st_geometry(spatial_attributes), add = TRUE)
# Plot (1st order) neighbors of Missouri
id <- 22 # Missouri id
spatial_attributes$neighbors <- "Other"
spatial_attributes$neighbors[id] <- "Missouri"
spatial_attributes$neighbors[states.nb[[id]]] <- "Neighbors"
ggplot(spatial_attributes) + geom_sf(aes(fill = neighbors)) + theme_bw() +
scale_fill_manual(values = c("gray30", "gray", "white"))
# Add 2nd order neighbors
spatial_attributes$neighbors <- "Other"
spatial_attributes$neighbors[unique(unlist(states.nb[states.nb[[id]]]))] <- "Neighbors-Neighbors"
spatial_attributes$neighbors[id] <- "Missouri"
spatial_attributes$neighbors[states.nb[[id]]] <- "Neighbors"
ggplot(spatial_attributes) + geom_sf(aes(fill = neighbors)) + theme_bw() +
scale_fill_manual(values = c("gray30", "gray", "lightgray", "white"))
# how many neighbors does each unit have?
card(dnn.nb)
rook.nb  <- poly2nb(spatial_attributes, queen = FALSE)
queen.nb <- states.nb  # already created above; renamed here for parallel naming
# check/compare number of connections
rook_neighbors  <- card(rook.nb)
queen_neighbors <- card(queen.nb)
mean(rook_neighbors)
mean(queen_neighbors) # as expected, mean is higher for queen (more permissive rule)

# install.packages(c("sf", "spdep", "tidyverse"))
library(sf)
library(spdep)
library(tidyverse)
##  MODULE 1 — From spatial process to spatial ties
## Load previously constructed GeoPackage
states_shootings <- st_read("states_joined.gpkg",
layer = "states_shooting_counts",
quiet = TRUE)
state_pop <- st_read("states_joined.gpkg",
layer = "states_joined",
quiet = TRUE) |>
st_drop_geometry() |>
select(GEOID, Population)
states <- states_shootings |>
left_join(state_pop, by = "GEOID") |>
mutate(shoot_rate = n_shootings / (Population / 1e6))    # per million
non_dc <- c( "11")                         # DC (no Pop in state.x77)
states <- states |>
filter(!GEOID %in% non_dc) |>
filter(is.finite(shoot_rate)) |>
st_transform(5070)  # NAD83 /  Albers, meters
## Attach TANF max monthly benefit (NCCP 2024)
## Temporary Assistance for Needy Families
state_tanf <- read.csv("state_tanf.csv",
colClasses = c(GEOID = "character"))
states <- states |>
left_join(state_tanf |> select(GEOID, tanf_max), by = "GEOID")
## TANF choropleth
ggplot(states) +
geom_sf(aes(fill = tanf_max), color = "white", linewidth = 0.2) +
scale_fill_viridis_c(option = "plasma", name = "$/month") +
labs(title = "Maximum monthly TANF benefit, family of three (2024)",
caption = "Source: NCCP 2024") +
theme_void()
##  MODULE 2 — What is W and what does it do?
## Spatial lags by hand ------------------------------
## Reproduce the slide example:
W_hand <- matrix(c(0,   1,   0,
0.5, 0,   0.5,
0,   1,   0),
nrow = 3, byrow = TRUE)
y_hand <- c(4, 2, 9)
Wy_hand <- W_hand %*% y_hand
##Exercise 2: W by hand for a 6-unit grid ----------
n <- 6
W_binary <- matrix(0, n, n)
# Fill neighbor relationships:
W_binary[1, c(2, 4, 5)]    <- 1
W_binary[2, c(1, 3, 4, 5, 6)] <- 1
W_binary[3, c(2, 5, 6)]    <- 1
W_binary[4, c(1, 2, 5)]    <- 1
W_binary[5, c(1, 2, 3, 4, 6)] <- 1
W_binary[6, c(2, 3, 5)]    <- 1
## TASK B: Row-normalize W so each row sums to 1.
row_sums <- rowSums(W_binary)
W_rs     <- W_binary / row_sums
## TASK C: Compute Wy for y = c(2, 4, 6, 8, 3, 1)
##         for units 1, 2, and 5.
y_grid <- c(2, 4, 6, 8, 3, 1)
Wy_grid <- W_rs %*% y_grid
##  MODULE 3 — Common ways to build W: contiguity, distance, k-NN, network
# Queen and rook contiguity
# Compute centroids for plotting
centroids <- st_coordinates(st_centroid(states))
# Queen contiguity (shared edge or vertex)
nb_queen <- poly2nb(states, queen = TRUE)
# Rook contiguity (shared edge only)
nb_rook  <- poly2nb(states, queen = FALSE)
# Convert to row-standardized listw objects
lw_queen <- nb2listw(nb_queen, style = "W", zero.policy = TRUE)
lw_rook  <- nb2listw(nb_rook,  style = "W", zero.policy = TRUE)
# Inspect
summary(nb_queen)
summary(nb_rook)
# Distribution of neighbor counts
table(card(nb_queen))
table(card(nb_rook))
##Plot queen and rook connectivity ------------------
plot(st_geometry(states), border = "grey70", main = "Queen contiguity")
plot(nb_queen, centroids, add = TRUE, col = "steelblue", lwd = 0.6)
plot(st_geometry(states), border = "grey70", main = "Rook contiguity")
plot(nb_rook, centroids, add = TRUE, col = "firebrick", lwd = 0.6)
## Higher-order contiguity: neighbors of Missouri
mo_id <- which(states$NAME == "Missouri")
# 1st-order queen neighbors
states$nbr_class <- "Other"
states$nbr_class[mo_id]             <- "Missouri"
states$nbr_class[nb_queen[[mo_id]]] <- "1st-order"
ggplot(states) +
geom_sf(aes(fill = nbr_class), color = "white", linewidth = 0.2) +
scale_fill_manual(values = c(Missouri    = "gray20",
`1st-order` = "gray60",
Other       = "white")) +
theme_void()
# 2nd-order: assign in widening order, overwrite inner rings
states$nbr_class <- "Other"
states$nbr_class[unique(unlist(nb_queen[nb_queen[[mo_id]]]))] <- "2nd-order"
states$nbr_class[nb_queen[[mo_id]]] <- "1st-order"
states$nbr_class[mo_id]             <- "Missouri"
ggplot(states) +
geom_sf(aes(fill = nbr_class), color = "white", linewidth = 0.2) +
scale_fill_manual(values = c(Missouri    = "gray20",
`1st-order` = "gray50",
`2nd-order` = "gray80",
Other       = "white")) +
theme_void()
## k-nearest neighbors (kNN)
# k = 4 nearest neighbors by centroid distance
knn4    <- knearneigh(centroids, k = 4)
nb_knn4 <- knn2nb(knn4)
lw_knn4 <- nb2listw(nb_knn4, style = "W")
summary(nb_knn4)
is.symmetric.nb(nb_knn4)
# k = 8
knn8    <- knearneigh(centroids, k = 8)
nb_knn8 <- knn2nb(knn8)
lw_knn8 <- nb2listw(nb_knn8, style = "W")
##  Distance bands
## At the scale of US states, adjacent-state centroids are
## typically 400-700 km apart and CONUS spans roughly 4500 km
## east-to-west.
# Distance band: 0 to 500 km (tight)
nb_d500 <- dnearneigh(centroids, d1 = 0, d2 = 500000)
lw_d500 <- nb2listw(nb_d500, style = "W", zero.policy = TRUE)
summary(nb_d500)
# Any islands (units with zero neighbors)?
islands_d500 <- which(card(nb_d500) == 0)
states$NAME[islands_d500]
# Widen to 1500 km (broad regional)
nb_d1500 <- dnearneigh(centroids, d1 = 0, d2 = 1500000)
lw_d1500 <- nb2listw(nb_d1500, style = "W", zero.policy = TRUE)
summary(nb_d1500)
## Inverse-distance weights
# Compute pairwise distances between centroids
dists <- nbdists(nb_queen, centroids)
# Inverse distance weights (using queen neighbor lists)
inv_dists <- lapply(dists, function(x) 1 / x)
lw_invd   <- nb2listw(nb_queen, glist = inv_dists, style = "W",
zero.policy = TRUE)
summary(lw_invd)
## These weights are constructed on the queen neighbor set, can
## instead do it over all pairs (no neighbor restriction)
# Pairwise centroid distances; scale to km for numerical readability
D <- as.matrix(dist(centroids)) / 1000        # km
W_invdist <- 1 / D
diag(W_invdist) <- 0 #no neighbors with self
# Inverse-distance-squared
W_invdist2 <- 1 / D^2
diag(W_invdist2) <- 0
## Higher-order contiguity (order 2)
## Higher-order contiguity includes neighbors-of-neighbors.
nb_queen2 <- nblag(nb_queen, maxlag = 2)
# nb_queen2[[1]] = first-order (same as nb_queen)
# nb_queen2[[2]] = second-order (neighbors of neighbors, not first-order)
summary(nb_queen2[[2]])
# Combined (cumulative): first AND second order
nb_cum2   <- nblag_cumul(nb_queen2)
lw_cum2   <- nb2listw(nb_cum2, style = "W", zero.policy = TRUE)
summary(nb_cum2)
##  MODULE 4 — Choosing, normalizing, and reporting W
# Row normalization vs. binary
## Row normalization: Wy is a weighted average of neighbors
## Binary (style = "B"): Wy is a weighted sum of neighbors
lw_queen_B  <- nb2listw(nb_queen, style = "B", zero.policy = TRUE)  # binary
lw_queen_W  <- nb2listw(nb_queen, style = "W", zero.policy = TRUE)  # row-std
states$lag_tanf_B <- lag.listw(lw_queen_B, states$tanf_max, zero.policy = TRUE)
states$lag_tanf_W <- lag.listw(lw_queen_W, states$tanf_max, zero.policy = TRUE)
data.frame(
W    = c("binary", "row-std"),
mean = c(mean(states$lag_tanf_B), mean(states$lag_tanf_W)),
sd   = c(sd(states$lag_tanf_B),   sd(states$lag_tanf_W))
)
## Why bother? (I - rho*W)^{-1} only behaves when rho sits inside the eigenvalue
## bounds rho in (1/lambda_min, 1/lambda_max). Row-standardizing pins
## lambda_max = 1; the binary graph does not (ties back to the toy
## eigen-example and the normalization slide).
W_queen_raw <- nb2mat(nb_queen, style = "B", zero.policy = TRUE)
W_queen_rs  <- nb2mat(nb_queen, style = "W", zero.policy = TRUE)
n   <- length(nb_queen)
rho <- 0.15
M_raw <- solve(diag(n) - rho*W_queen_raw)
M_rs  <- solve(diag(n) - rho*W_queen_rs)
# Row sums ~= cumulative impact of a unit shock under each spec
range(rowSums(M_raw))
range(rowSums(M_rs))
# Non-normalized are erratic, non-sensical, and very sensitive to \rho
## Max-eigenvalue normalization
## Extract the raw binary W as a sparse matrix, then normalize
## by its maximum eigenvalue.
W_mat <- listw2mat(lw_queen_B)      # convert listw to dense matrix
eigenvalues <- eigen(W_mat, only.values = TRUE)$values
lambda_max  <- max(Re(eigenvalues))
round(lambda_max, 4)
W_lambda  <- W_mat / lambda_max
round(max(Re(eigen(W_lambda, only.values = TRUE)$values)), 4)
## Unlike row normalization, scalar (max-eigenvalue) normalization
## preserves mutual proportions between elements and does NOT
## convert the spatial lag into a row-level average.
## Computing spatial lags with different W's
## How do different W's produce different lags of the SAME outcome?
states$lag_queen <- lag.listw(lw_queen, states$tanf_max, zero.policy = TRUE)
states$lag_knn4  <- lag.listw(lw_knn4,  states$tanf_max)
states$lag_knn8  <- lag.listw(lw_knn8,  states$tanf_max)
states$lag_d500  <- lag.listw(lw_d500,  states$tanf_max, zero.policy = TRUE)
states$lag_d1500 <- lag.listw(lw_d1500, states$tanf_max, zero.policy = TRUE)
states$lag_ord2  <- lag.listw(lw_cum2,  states$tanf_max, zero.policy = TRUE)
# Correlation across W specifications
lag_df <- states |> st_drop_geometry() |>
select(lag_queen, lag_knn4, lag_knn8, lag_d500, lag_d1500, lag_ord2)
round(cor(lag_df, use = "complete.obs"), 3)
###Written by Scott Cook
###July 8, 2026
###Based off Griffith (2003) and Juhl (2021)
getwd()
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
#install.packages(c("sf","sp","spatialreg","spdep", "spfilteR"))
library(spfilteR)
###Written by Scott Cook
###July 8, 2026
###Based off Griffith (2003) and Juhl (2021)
getwd()
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
install.packages(c("spfilteR"))
library(spfilteR)
library(sf)
library(sp)
library(spatialreg)
library(spdep)
unzip("cb_2017_us_state_500k.zip")
states <- st_read("cb_2017_us_state_500k.shp")
states_contig <- subset(states, NAME != "Commonwealth of the Northern Mariana Islands" &
NAME != "United States Virgin Islands"  & NAME != "American Samoa" &
NAME != "Puerto Rico" & NAME != "Guam" & NAME != "Alaska" & NAME != "Hawaii")
states_contig <- subset(states_contig, NAME != "District of Columbia")
states_contig_albers <- st_transform(states_contig, 5070)
queen.nb <- poly2nb(states_contig_albers, queen = T)
weightslist.rs <- nb2listw(queen.nb, style = "W")
W <- listw2mat(weightslist.rs)
EVs <- getEVs(W=W,covars=NULL)
E <- EVs$vectors
spatial_attributes <- cbind(states_contig_albers, E)
spatial_attributes
plot(spatial_attributes["X1"])
plot(spatial_attributes["X2"])
plot(spatial_attributes["X3"])
plot(spatial_attributes["X4"])
plot(spatial_attributes["X5"])
spatial_attributes <- cbind(spatial_attributes, rowSums(E))
plot(spatial_attributes["rowSums.E."])
#simulated grid
sfc <- st_sfc(st_polygon(list(rbind(c(0,0), c(5,0), c(5,5), c(0,0)))))
grid <- st_make_grid(sfc, cellsize = .5, square = T) #note that the cellsize/length of the bounding box determines n
plot(grid)
grid_sf <- st_as_sf(grid)
grid.nb <- poly2nb(grid_sf, queen = T)
Wmat_rs <-nb2mat(grid.nb, style="W", zero.policy=TRUE) # to row-standardized listw
EVs <- getEVs(W=Wmat_rs,covars=NULL)
E <- EVs$vectors
grid_sf_att <- cbind(grid_sf, E)
##positive dependence
plot(grid_sf_att["X1"])
plot(grid_sf_att["X2"])
plot(grid_sf_att["X3"])
plot(grid_sf_att["X4"])
plot(grid_sf_att["X5"])
#negative dependence
plot(grid_sf_att["X98"])
plot(grid_sf_att["X99"])
plot(grid_sf_att["X100"])
